{
  "id": "cabinet-studio",
  "name": "Cabinet Studio",
  "version": "0.0.5",
  "description": "PLUG-0 spike: cabinets from Cabinet Studio's core, built in SolidCraft.",
  "capabilities": [
    "commands@0.2",
    "ui@0.1",
    "storage@0.1",
    "dialog@0.1"
  ],
  "runtime": {
    "module": "cabinet-studio.wasm",
    "data_format": 1,
    "commands": [
      "storage.get",
      "storage.set",
      "view.fit",
      "component.create",
      "component.activate",
      "component.delete",
      "component.metadata.set",
      "appearance.assign",
      "solid.box",
      "solid.cylinder",
      "solid.extrude",
      "solid.fillet",
      "solid.chamfer",
      "solid.move",
      "sketch.create",
      "sketch.finish",
      "sketch.line",
      "sketch.arc.three_point",
      "sketch.circle.center",
      "occurrence.copy",
      "occurrence.move",
      "occurrence.ground",
      "select.set",
      "component.list"
    ],
    "entries": [
      {
        "name": "setup",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "title": "Job setup",
          "x-solidcraft-icon": "icons/job.svg",
          "properties": {}
        }
      },
      {
        "name": "boards",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "title": "Boards",
          "x-solidcraft-icon": "icons/job.svg",
          "properties": {}
        }
      },
      {
        "name": "add",
        "effect": "edit",
        "slots": [
          {
            "kind": "ribbon",
            "name": "Add"
          }
        ],
        "input_schema": {
          "type": "object",
          "title": "Add cabinet",
          "x-solidcraft-icon": "icons/add.svg",
          "x-solidcraft-field-order": "declared",
          "properties": {
            "kind": {
              "type": "string",
              "title": "Type",
              "default": "base",
              "oneOf": [
                {
                  "const": "base",
                  "title": "Base",
                  "x-solidcraft-image": "pictures/base.png"
                },
                {
                  "const": "drawer_bank",
                  "title": "Drawers",
                  "x-solidcraft-image": "pictures/drawer_bank.png"
                },
                {
                  "const": "sink",
                  "title": "Sink",
                  "x-solidcraft-image": "pictures/sink.png"
                },
                {
                  "const": "wall",
                  "title": "Wall",
                  "x-solidcraft-image": "pictures/wall.png"
                }
              ]
            },
            "width": {
              "type": "number",
              "title": "Width",
              "default": 600,
              "minimum": 150,
              "maximum": 1200,
              "unit": "mm"
            },
            "detail": {
              "type": "string",
              "title": "Detail",
              "default": "design",
              "oneOf": [
                {
                  "const": "design",
                  "title": "Design: plain panels"
                },
                {
                  "const": "manufacturing",
                  "title": "Manufacturing: every hole and slot"
                }
              ]
            }
          }
        }
      },
      {
        "name": "edit",
        "effect": "edit",
        "dialog_hook": true,
        "slots": [
          {
            "kind": "ribbon",
            "name": "Edit"
          }
        ],
        "input_schema": {
          "type": "object",
          "title": "Edit cabinet",
          "x-solidcraft-icon": "icons/edit.svg",
          "x-solidcraft-field-order": "declared",
          "required": [
            "pick"
          ],
          "properties": {
            "pick": {
              "type": "array",
              "title": "Cabinet",
              "description": "Any part of the cabinet to change",
              "x-solidcraft-selection": {
                "version": 1,
                "accept": [
                  "body"
                ]
              },
              "minItems": 1
            },
            "kind": {
              "type": "string",
              "title": "Type",
              "default": "base",
              "oneOf": [
                {
                  "const": "base",
                  "title": "Base",
                  "x-solidcraft-image": "pictures/base.png"
                },
                {
                  "const": "drawer_bank",
                  "title": "Drawers",
                  "x-solidcraft-image": "pictures/drawer_bank.png"
                },
                {
                  "const": "sink",
                  "title": "Sink",
                  "x-solidcraft-image": "pictures/sink.png"
                },
                {
                  "const": "wall",
                  "title": "Wall",
                  "x-solidcraft-image": "pictures/wall.png"
                }
              ]
            },
            "width": {
              "type": "number",
              "title": "Width",
              "default": 600,
              "minimum": 150,
              "maximum": 1200,
              "unit": "mm"
            },
            "detail": {
              "type": "string",
              "title": "Detail",
              "default": "design",
              "oneOf": [
                {
                  "const": "design",
                  "title": "Design: plain panels"
                },
                {
                  "const": "manufacturing",
                  "title": "Manufacturing: every hole and slot"
                }
              ]
            }
          }
        }
      },
      {
        "name": "benchtop",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "title": "Benchtop",
          "x-solidcraft-icon": "icons/benchtop.svg",
          "properties": {}
        }
      },
      {
        "name": "end-panel",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "title": "End panel or filler",
          "x-solidcraft-icon": "icons/benchtop.svg",
          "properties": {}
        }
      },
      {
        "name": "splashback",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "title": "Splashback",
          "x-solidcraft-icon": "icons/benchtop.svg",
          "properties": {}
        }
      },
      {
        "name": "show",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "title": "Show the Cabinets panel",
          "x-solidcraft-icon": "icons/panel.svg",
          "properties": {}
        }
      },
      {
        "name": "refresh",
        "effect": "read",
        "input_schema": {
          "type": "object",
          "title": "Refresh",
          "x-solidcraft-icon": "icons/panel.svg",
          "properties": {}
        }
      },
      {
        "name": "select",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "title": "Select in the view",
          "x-solidcraft-icon": "icons/panel.svg",
          "properties": {
            "row": {
              "type": "string",
              "title": "Cabinet",
              "default": ""
            }
          }
        }
      },
      {
        "name": "rebuild",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "title": "Rebuild all",
          "x-solidcraft-icon": "icons/panel.svg",
          "properties": {}
        }
      },
      {
        "name": "export",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "title": "Cut list (CSV)",
          "x-solidcraft-icon": "icons/cutlist.svg",
          "properties": {}
        }
      },
      {
        "name": "sheets",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "title": "Cut sheets",
          "x-solidcraft-icon": "icons/cutlist.svg",
          "properties": {}
        }
      }
    ],
    "permissions": {
      "files": [
        {
          "name": "exports",
          "write": true
        }
      ]
    },
    "ui": {
      "ui_version": 1,
      "panels": [
        {
          "id": "cabinets",
          "title": "Cabinets",
          "zones": [
            "right",
            "bottom"
          ],
          "layout": {
            "root": 0,
            "nodes": [
              {
                "widget": {
                  "group": [
                    1,
                    2
                  ]
                }
              },
              {
                "widget": {
                  "toolbar": [
                    {
                      "label": "Refresh",
                      "icon": null,
                      "entry": "refresh"
                    },
                    {
                      "label": "Export cut list",
                      "icon": null,
                      "entry": "export"
                    }
                  ]
                }
              },
              {
                "widget": {
                  "table": {
                    "bind": "/cabinets",
                    "row_id": "id",
                    "columns": [
                      {
                        "key": "id",
                        "label": "Cabinet",
                        "unit": null
                      },
                      {
                        "key": "kind",
                        "label": "Type",
                        "unit": null
                      },
                      {
                        "key": "width",
                        "label": "Width",
                        "unit": "length"
                      }
                    ],
                    "select": "single",
                    "on_select": "select",
                    "on_edit": null
                  }
                }
              }
            ]
          }
        }
      ],
      "workspaces": []
    },
    "limits": {
      "fuel": 20000000000,
      "memory_mib": 64,
      "deadline_ms": 30000
    },
    "ribbon_groups": [
      {
        "label": "Job",
        "icon": "icons/job.svg",
        "entries": [
          "setup",
          "boards"
        ]
      },
      {
        "label": "Benchtop",
        "icon": "icons/benchtop.svg",
        "entries": [
          "benchtop",
          "end-panel",
          "splashback"
        ]
      },
      {
        "label": "Cabinets",
        "icon": "icons/panel.svg",
        "entries": [
          "show",
          "refresh",
          "select",
          "rebuild"
        ]
      },
      {
        "label": "Cut List",
        "icon": "icons/cutlist.svg",
        "entries": [
          "export",
          "sheets"
        ]
      }
    ]
  }
}
